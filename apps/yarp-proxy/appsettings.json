{
  "Proxy": {
    "ApiKeyHeader": "api-key",
    "ApiKey": "",
    "UpstreamTimeoutMinutes": 10
  },
  "ReverseProxy": {
    "Routes": {
      "mcp-route": {
        "ClusterId": "mcp-cluster",
        "Match": {
          "Path": "/mcp/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "mcp-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://mongodb-mcp-server.tools.svc.cluster.local:3000/"
          }
        },
        "SessionAffinity": {
          "Enabled": false,
          "Policy": "HashCookie",
          "FailurePolicy": "Redistribute"
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
