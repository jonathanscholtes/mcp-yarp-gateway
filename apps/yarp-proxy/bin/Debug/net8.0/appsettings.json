{
  "Proxy": {
    "ApiKeyHeader": "X-API-Key",
    "ApiKey": "",
    "UpstreamTimeoutMinutes": 10
  },
  "ReverseProxy": {
    "Routes": {
      "mcp-route": {
        "ClusterId": "mcp-cluster",
        "Match": {
          "Path": "/mcp/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "mcp-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://aifoundryapimdev.azure-api.net/halo-itsm-mcp/mcp/"
          }
        },
        "SessionAffinity": {
          "Enabled": false,
          "Policy": "HashCookie",
          "FailurePolicy": "Redistribute"
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
