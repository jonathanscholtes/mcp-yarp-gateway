# =============================================================================
# MCP YARP Gateway — .gitignore
# Covers: .NET 8, Python, Bicep/ARM, Helm, Docker, VS Code, general editors
# =============================================================================

# -----------------------------------------------------------------------------
# .NET / C#
# -----------------------------------------------------------------------------
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/
*.pidb
*.pdb
*.ilk
*.meta
*.cache
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
*.nupkg
*.snupkg
project.lock.json
artifacts/

# ASP.NET Core
launchSettings.json
appsettings.*.local.json

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.eggs/
*.pyo
*.pyd
.Python
.venv/
venv/
env/
ENV/
.env
.env.*
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
poetry.lock
Pipfile.lock

# Jupyter
.ipynb_checkpoints/
*.ipynb

# -----------------------------------------------------------------------------
# Bicep / ARM / Terraform
# -----------------------------------------------------------------------------
